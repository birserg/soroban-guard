# Testnet fixtures for local development. Gitignored — see .env.example.
# Public addresses only; secret keys stay in ~/.config/stellar/identity/.

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar Asset Contract for TEST:<issuer>, deployed 2026-09-10.
# Note: a SAC, not a custom SEP-41 token — recipients need a trustline
# before they can receive, and its events carry an extra sep0011_asset topic.
TESTNET_CONTRACT_ID=

# Issuer and admin of TEST. balance() returns i64::MAX for this account —
# an issuer mints on payout rather than holding a balance, so it is not a
# usable subject for balance-delta assertions.
ISSUER_ADDRESS=

# Ordinary accounts, both with a TEST trustline. OWNER holds the balance and
# grants allowances; SPENDER receives them.
OWNER_ADDRESS=
SPENDER_ADDRESS=

# stellar-cli identity aliases for the addresses above.
ISSUER_KEY=sf
ALICE_KEY=alice
BOB_KEY=bob
