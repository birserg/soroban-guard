# Testnet fixtures for local development. Copy to .env and fill in the blanks.
# .env is gitignored. Reads need only public addresses; the write checks need
# a secret key — see the last section, and prefer the stellar-cli keystore at
# ~/.config/stellar/identity/ over writing one into a file.

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar Asset Contract for TEST:<issuer>, deployed 2026-09-10.
# Note: a SAC, not a custom SEP-41 token — recipients need a trustline
# before they can receive, and its events carry an extra sep0011_asset topic.
TESTNET_CONTRACT_ID=

# Issuer and admin of TEST. balance() returns i64::MAX for this account —
# an issuer mints on payout rather than holding a balance, so it is not a
# usable subject for balance-delta assertions.
ISSUER_ADDRESS=

# Probe addresses. OWNER is funded on demand and needs a pre-existing TEST
# trustline for balance assertions (leave unset for a generated probe, which
# reports UNVERIFIABLE instead of false verdicts). SPENDER is never funded.
OWNER_ADDRESS=
SPENDER_ADDRESS=

# stellar-cli identity aliases for the addresses above, by the role each
# plays: the owner holds the balance, the spender receives allowances.
# `stellar keys address <alias>` prints the matching G… address.
ISSUER_KEY=issuer
OWNER_KEY=owner
SPENDER_KEY=spender

# --- Write checks (transfer, and the rest as they land) -------------------
#
# Reads need no key. State-changing checks must sign as the holder, so
# without a secret they report UNVERIFIABLE — never FAIL, because a missing
# key is a fact about this run, not about the contract.
#
# TESTNET ONLY, and enforced rather than asked: a secret set alongside a
# non-testnet NETWORK_PASSPHRASE is refused before any network call, since
# funding is check-first and a funded mainnet account would never touch the
# faucet. Never put a key here that holds mainnet value.
#
# Prefer keeping secrets in the stellar-cli keystore and passing them at the
# point of use, so they never land in a file:
#
#   OWNER_SECRET=$(stellar keys show owner) \
#     node packages/soroban-guard/src/cli.ts <contract-id>
#
# A secret settles its own address. If *_ADDRESS is also set and the two
# disagree, the run exits rather than guessing which you meant.
OWNER_SECRET=
SPENDER_SECRET=
